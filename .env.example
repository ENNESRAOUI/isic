# ISIC Backend Configuration

# Anthropic API Key (for AI analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database URL
# For SQLite (default): sqlite:///./isic.db
# For PostgreSQL: postgresql://user:password@localhost:5432/isic
DATABASE_URL=sqlite:///./isic.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# CORS allowed origins
CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:8000"]

# Pipeline timeout (seconds)
PIPELINE_TIMEOUT=600
